HOST_NAME=My OpenShip Server
OPENSHIP_URL=https://openship.example.com
OPENSHIP_API_KEY=replace-with-personal-access-token
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Comma-separated numeric Telegram user IDs and/or chat IDs.
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=
POLL_INTERVAL_MS=5000
DEPLOYMENT_POLL_INTERVAL_MS=10000
# Optional authenticated host-runner service. The Telegram bot never executes
# these scripts or mounts the host; the separate runner validates named actions
# and owns execution on the VPS.
# For the bundled VPS host runner, use the private Docker-host gateway:
# MAINTENANCE_RUNNER_URL=http://host.docker.internal:8787
MAINTENANCE_RUNNER_URL=
MAINTENANCE_RUNNER_TOKEN=
# Defaults for the supported VPS installation; change for another installation.
PATCH_CACHE_PATH=/root/openship-patches/patch-cache.sh
PATCH_BRANDING_PATH=/root/openship-branding/patch-branding.sh
PATCH_PROGRESS_INTERVAL_MS=15000
